# ============================================================
# dsh 局域网部署（~/.dsh） .gitignore
# 用途：开源「插件 + 配置 + 脚本」，排除三类内容：
#   (1) 可再生依赖 / 二进制   (2) 机密   (3) 运行时数据
# 迁移请走 MIGRATION.md 的 robocopy 流程，不受本文件影响。
# ============================================================

# ---- 依赖（pnpm install / winget 可重建）----
node_modules/

# ---- 机密（绝不能进 git）----
.credentials.yaml
auth/
.env
.env.*

# profile 真实配置含 sidecar token，只留本地；提交脱敏版 cordis.patch.example.yml
profiles/web/cordis.patch.yml
# 同理：web-client 的 patch 是从 web 复制来的，含同一批真实 sidecar token
profiles/web-client/cordis.patch.yml

# 备份包（含机密 + 会话数据，绝不进 git）
backup/

# ---- 运行时数据 / 会话 / 附件 ----
sessions/
sessions-archived/
sessions-012-bak/
attachments/
storages/
llm-deepseek/
seeed-cli/

# ---- 机器相关状态 ----
.anonymous-user-id
dsh-remote-files.json
upgrade-state.json

# ---- 机器相关真实配置（含 IP/路径，install.ps1 生成，模板见 *.example）----
Caddyfile
start-dsh-lan.cmd

# ---- 二进制 / 离线运行时（可重建）----
bin/
runtimes/

# 客户端执行器分发包（exe + node-pty，80+ MB）：跑 node build-executor-exe.mjs 重建，
# 服务器上的下载端点直接读这个产物，所以不进 git
plugins/dsh-subprocess-dispatch/dist/
# 同一个构建脚本的中间产物（CJS bundle / SEA blob），每次构建都会重建
.build/

# ---- manifest 校对工具：打包产物 / 内嵌 FFmpeg（可重建）----
tools/manifest-tool/dist/
tools/manifest-tool/ffmpeg/
plugins/dsh-video-studio-local/assets/

# ---- profile 内可再生 / 数据目录 ----
profiles/web/data/
profiles/web/.dsh-module-fallback/

# ---- 日志 / 诊断 / 备份产物 ----
*.log
prof/
*.bak

# ---- 插件内嵌套的独立 git 仓库 ----
plugins/*/.git/

# ---- 误生成的 0 字节杂项文件 ----
/3080

# P4/P5 verification harness output (pilot profile)
# pilot / pilot-auth verification harness output
profiles/pilot*/dispatch-trace.jsonl
profiles/pilot*/probe-result.jsonl
profiles/pilot*/crash-armed.marker
# executor state文件含测试 token，链路中继的开关文件是运行时状态
profiles/pilot*/executor-state*.json
profiles/pilot*/link-state.txt
profiles/web-client/dispatch-trace.jsonl
profiles/web-client/probe-result.jsonl
# 误生成的 0 字节杂项文件（同 /3080：某次命令里裸写的地址被当成了重定向目标）
/127.0.0.1

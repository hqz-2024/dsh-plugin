{
  "name": "dsh-profile-web-client",
  "private": true,
  "dependencies": {
    "@deepseek-ai/dsh-terminal": "0.0.1-rc.3",
    "@deepseek-ai/dsh-terminal-bash": "0.0.1-rc.3",
    "@deepseek-ai/dsh-tool-terminal": "0.0.1-rc.5",
    "@xgone/dsh-remote": "link:../../plugins/dsh-remote-local",
    "dsh-doc": "0.1.1",
    "dsh-local-bridge": "link:../../plugins/dsh-local-bridge",
    "folder-tree-sh": "link:../../plugins/folder-tree-sh-local",
    "dsh-video-studio": "link:../../plugins/dsh-video-studio-local",
    "dsh-client-bindings": "link:../../plugins/dsh-client-bindings",
    "dsh-subprocess-dispatch": "link:../../plugins/dsh-subprocess-dispatch"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "@xgone/dsh-remote",
        "dsh-doc",
        "folder-tree-sh",
        "dsh-local-bridge",
        "dsh-video-studio",
        "dsh-client-bindings",
        "dsh-subprocess-dispatch"
      ],
      "patchReload": "live"
    }
  }
}
